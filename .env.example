# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Any Postgres database. On Vercel, add the Neon or Postgres integration and
# this is filled in for you. Use the POOLED connection string — serverless
# functions open a lot of short-lived connections.
DATABASE_URL="postgresql://user:password@host:5432/swifttickets?sslmode=require"

# Signs the session cookie. Generate one with:  openssl rand -base64 32
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Optional — the app runs without these, with the feature simulated instead
# ---------------------------------------------------------------------------

# Absolute URL of the deployment. Used to build the QR verification links that
# go out in tickets. Defaults to the request's own host, which is correct on
# Vercel; set it explicitly if you serve the app behind another domain.
PUBLIC_BASE_URL=""

# Card payments. Without a key, checkout runs in demo mode: cards are
# validated (Luhn, expiry, CVC) and approved without money moving.
STRIPE_SECRET_KEY=""
STRIPE_CURRENCY="usd"

# Ticket emails (https://resend.com). Without these, the confirmation screen
# still previews the email but nothing is sent.
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="Swift Tickets <tickets@yourdomain.com>"

# Ticket SMS (https://twilio.com). Same story: previewed, not sent.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ---------------------------------------------------------------------------
# Seeding only
# ---------------------------------------------------------------------------
SEED_ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""
